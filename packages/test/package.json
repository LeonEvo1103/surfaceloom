{
  "name": "@surfaceloom/test",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeonEvo1103/surfaceloom.git",
    "directory": "packages/test"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sl-test": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./report": {
      "types": "./dist/report/index.d.ts",
      "import": "./dist/report/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.json && node ../../scripts/copy-package-license.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node ../../scripts/run-typescript-package-tests.mjs"
  },
  "dependencies": {
    "@surfaceloom/core": "file:../core",
    "@surfaceloom/llm-judge": "file:../llm-judge",
    "@surfaceloom/reporter": "file:../reporter"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": { "node": ">=20" }
}
