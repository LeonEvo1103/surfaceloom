{
  "name": "@surfaceloom/service",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeonEvo1103/surfaceloom.git",
    "directory": "packages/service"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:kernel": "npm --prefix ../core run build && npm --prefix ../llm-judge run build && npm --prefix ../reporter run build && npm --prefix ../test run build",
    "build": "npm run build:kernel && node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.json && node ../../scripts/copy-package-license.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node ../../scripts/run-typescript-package-tests.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@surfaceloom/test": "file:../test",
    "zod": "4.6.5"
  }
}
