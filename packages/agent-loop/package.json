{
  "name": "@surfaceloom/agent-loop",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "keywords": [
    "ai-agents",
    "agent-observability",
    "agent-traces",
    "trace-visualization",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeonEvo1103/surfaceloom.git",
    "directory": "packages/agent-loop"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapter-sdk": {
      "types": "./dist/adapter-sdk.d.ts",
      "import": "./dist/adapter-sdk.js"
    }
  },
  "bin": {
    "surfaceloom-agent-loop": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:core": "tsc -p ../core/tsconfig.json",
    "build": "npm run build:core && node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.json && node ../../scripts/copy-package-license.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node ../../scripts/run-typescript-package-tests.mjs && node ../../scripts/test-agent-loop-external-adapter.mjs"
  },
  "peerDependencies": {
    "@surfaceloom/core": "0.1.0"
  },
  "devDependencies": {
    "@surfaceloom/core": "file:../core",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
