{
  "name": "@surfaceloom/component-catalog",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeonEvo1103/surfaceloom.git",
    "directory": "packages/component-catalog"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog.json": "./dist/catalog.json",
    "./fixtures.json": "./dist/fixtures.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:core": "tsc -p ../core/tsconfig.json",
    "build": "npm run build:core && node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.json && node scripts/export-catalog.mjs && node ../../scripts/copy-package-license.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node ../../scripts/run-typescript-package-tests.mjs"
  },
  "dependencies": {
    "@surfaceloom/core": "file:../core"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
