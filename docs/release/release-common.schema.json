{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surfaceloom.dev/schemas/release-common.schema.json",
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^(?!0{64}$)[a-f0-9]{64}$" }
      }
    },
    "stringMap": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "jsonValue": {
      "oneOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "dependencies", "peerDependencies", "optionalDependencies", "exports", "bin", "assets", "license"],
      "properties": {
        "name": { "type": "string", "pattern": "^@surfaceloom/" },
        "version": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?$" },
        "dependencies": { "$ref": "#/$defs/stringMap" },
        "peerDependencies": { "$ref": "#/$defs/stringMap" },
        "optionalDependencies": { "$ref": "#/$defs/stringMap" },
        "exports": { "$ref": "#/$defs/jsonValue" },
        "bin": { "$ref": "#/$defs/jsonValue" },
        "assets": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "license": { "const": "MIT" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "os", "arch", "rid", "runtime", "deployment", "minOS", "universalSlices"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "os": { "enum": ["windows", "macos", "linux"] },
        "arch": { "enum": ["x64", "arm64", "universal"] },
        "rid": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 },
        "deployment": { "enum": ["self-contained", "framework-dependent"] },
        "minOS": { "type": "string", "minLength": 1 },
        "universalSlices": { "type": "array", "uniqueItems": true, "items": { "enum": ["x64", "arm64"] } }
      }
    },
    "protocols": {
      "type": "object",
      "additionalProperties": false,
      "required": ["npm", "wire", "report", "trace", "component", "nativeHost"],
      "properties": {
        "npm": { "const": "npm-package/1" },
        "wire": { "const": "surfaceloom.native/1.0" },
        "report": { "const": "surfaceloom.report/v3" },
        "trace": { "const": "surfaceloom.agent-loop/v1" },
        "component": { "const": "surfaceloom.component-catalog/1" },
        "nativeHost": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?$" }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "toolchain", "target"],
      "properties": {
        "workflow": { "type": "string", "minLength": 1 },
        "toolchain": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "version"],
            "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
          }
        },
        "target": { "type": "string", "minLength": 1 }
      }
    },
    "inventory": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "byteLength", "digest"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "byteLength": { "type": "integer", "minimum": 0 },
          "digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "auxiliary": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "byteLength", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "byteLength": { "type": "integer", "minimum": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "signatureEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "path", "byteLength", "digest", "subjectDigest"],
      "properties": {
        "kind": { "enum": ["embedded-verification", "detached-signature", "notarization-ticket"] },
        "path": { "type": "string", "minLength": 1 },
        "byteLength": { "type": "integer", "minimum": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "subjectDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "finalSignature": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "const": "unsigned" } } },
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "identity", "evidence"],
          "properties": {
            "status": { "enum": ["unverified", "verified"] },
            "identity": { "type": "string", "minLength": 1 },
            "evidence": { "$ref": "#/$defs/signatureEvidence" }
          }
        }
      ]
    }
  }
}
