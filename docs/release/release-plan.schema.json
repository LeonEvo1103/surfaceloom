{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surfaceloom.dev/schemas/release-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "state", "packages", "packageBuildOrder", "readiness", "targets", "protocols", "source", "signingPolicy", "expectedArtifacts", "pipeline"],
  "properties": {
    "schemaVersion": { "const": "surfaceloom.release-plan/1" },
    "releaseId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "state": { "enum": ["pending", "ready"] },
    "packages": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": { "$ref": "release-common.schema.json#/$defs/package" }
    },
    "packageBuildOrder": { "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": { "type": "string" } },
    "readiness": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "blockers"],
      "properties": {
        "status": { "enum": ["pending", "ready"] },
        "blockers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "targets": { "type": "array", "minItems": 1, "items": { "$ref": "release-common.schema.json#/$defs/target" } },
    "protocols": { "$ref": "release-common.schema.json#/$defs/protocols" },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "revision", "snapshotDigest", "dirtyPolicy", "lockDigest", "build"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "$ref": "#/$defs/revisionFact" },
        "snapshotDigest": { "$ref": "#/$defs/digestFact" },
        "dirtyPolicy": { "enum": ["require-clean", "record-dirty"] },
        "lockDigest": { "$ref": "#/$defs/digestFact" },
        "build": { "$ref": "release-common.schema.json#/$defs/build" }
      }
    },
    "signingPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["artifacts", "manifest"],
      "properties": {
        "artifacts": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "identityPolicy"],
          "properties": { "status": { "const": "planned" }, "identityPolicy": { "type": "string", "minLength": 1 } }
        },
        "manifest": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "format", "identityPolicy"],
          "properties": {
            "status": { "const": "planned" },
            "format": { "type": "string", "minLength": 1 },
            "identityPolicy": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "expectedArtifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "targetId", "path", "kind", "inventoryPaths", "signature"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "targetId": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["tgz", "zip", "exe", "app"] },
          "inventoryPaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "signature": {
            "oneOf": [
              { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "const": "planned" } } },
              { "$ref": "release-common.schema.json#/$defs/finalSignature" }
            ]
          }
        }
      }
    },
    "pipeline": { "const": ["build", "strip", "platform-sign-and-staple", "final-package", "digest", "sbom-scan-provenance", "manifest", "detached-manifest-signature"] }
  },
  "$defs": {
    "revisionFact": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "const": "pending" } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "value"], "properties": { "status": { "const": "resolved" }, "value": { "type": "string", "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$" } } }
      ]
    },
    "digestFact": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "const": "pending" } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "value"], "properties": { "status": { "const": "resolved" }, "value": { "$ref": "release-common.schema.json#/$defs/digest" } } }
      ]
    }
  }
}
